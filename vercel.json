{
    "version": 2,
    "builds": [
      { "src": "next.config.js", "use": "@vercel/next" }
    ],
    "routes": [
      { "src": "/(.*)", "dest": "/" }
    ],
    "env": {
      "NEXT_PUBLIC_ENVIRONMENT": "@minforsakring_environment"
    },
    "build": {
      "env": {
        "NEXT_PUBLIC_ENVIRONMENT": "@minforsakring_environment"
      }
    },
    "github": {
      "enabled": true,
      "autoAlias": false
    }
  }